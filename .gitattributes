# 换行处理约定
# 说明：本仓库有“按字节教学”的样例数据（如故意用 GBK 编码的 .txt、
# 含 CRLF 的样例文件），因此不对数据文件做换行转换，避免 git 改动它们的原始字节。

# 源码：统一使用 LF，跨 Windows/Linux 一致
*.py   text eol=lf
*.md   text eol=lf
*.toml text eol=lf
*.yml  text eol=lf
*.yaml text eol=lf
*.cfg  text eol=lf
.gitignore    text eol=lf
.gitattributes text eol=lf
LICENSE       text eol=lf

# 数据/样例：保持原始字节，禁止换行转换
*.txt  -text

# 明确按二进制处理
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.ico  binary
*.pdf  binary
*.zip  binary
*.gz   binary
*.docx binary
*.xlsx binary
*.pptx binary
